{
  "name": "nuxt3-blog-site",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "build-for-test": "cross-env VITESTING=\"true\" nuxt build",
    "dev-for-test": "cross-env PORT=13000 VITESTING=\"true\" nuxt dev",
    "prod-for-test": "cross-env PORT=13000 node .output/server/index.mjs",
    "generate": "nuxt generate",
    "local:change-pwd": "gulp change-passwd",
    "local:generate-file-map": "gulp generate-file-map",
    "local:download-file": "gulp download-file",
    "local:substitute-file": "gulp substitute-file",
    "local:upload-algolia": "gulp upload-algolia",
    "local:migrate-content": "gulp migrate-content",
    "release": "node scripts/release.mjs",
    "test:unit": "vitest run --exclude ./e2e",
    "test:e2e": "vitest run --dir ./e2e",
    "test:prod-and-e2e": "start-server-and-test prod-for-test http://localhost:13000 test:e2e",
    "test:dev-and-e2e": "start-server-and-test dev-for-test http://localhost:13000 test:e2e",
    "eslint": "eslint --fix .",
    "typecheck": "nuxi typecheck",
    "preview": "nuxt preview",
    "prepare": "husky"
  },
  "dependencies": {
    "nuxt3-blog": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nuxt/eslint": "1.0.1",
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.54.1",
    "@types/gulp": "^4.0.17",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-vue": "^9.33.0",
    "gulp": "^5.0.1",
    "happy-dom": "^17.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nuxt": "^4.4.7",
    "start-server-and-test": "^2.0.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.13"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@9.13.2+sha512.88c9c3864450350e65a33587ab801acf946d7c814ed1134da4a924f6df5a2120fd36b46aab68f7cd1d413149112d53c7db3a4136624cfd00ff1846a0c6cef48a"
}
